# =============================================================================
#  Telegram AI Assistant - environment configuration
# =============================================================================
#  Copy this file to `.env` and fill in the blanks.
#  `.env` is gitignored. This file (.env.example) IS committed, so that anyone
#  cloning the repo knows which variables exist - without learning the values.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_ENV=development          # development | production
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
API_HOST=0.0.0.0
API_PORT=8000

# --- Internal auth (n8n -> Python) -------------------------------------------
# Shared secret sent by n8n as the `X-API-Key` header. Any long random string.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=

# --- Anthropic (Phase 5) -----------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Telegram (Phase 3) ------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs allowed to talk to the bot.
# Empty = nobody is allowed (deny by default). Get your ID from @userinfobot.
TELEGRAM_ALLOWED_USER_IDS=

# --- Qdrant (vector database) ------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=knowledge_base

# --- Postgres ----------------------------------------------------------------
# These are read BOTH by Python and by docker-compose.yml (single source of truth)
POSTGRES_USER=assistant
POSTGRES_PASSWORD=
POSTGRES_DB=assistant
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- n8n ---------------------------------------------------------------------
# Encrypts stored credentials. If you change this, n8n can no longer decrypt
# credentials saved earlier. Set it once, keep it forever, back it up.
N8N_ENCRYPTION_KEY=
N8N_PORT=5678
GENERIC_TIMEZONE=Europe/Helsinki
