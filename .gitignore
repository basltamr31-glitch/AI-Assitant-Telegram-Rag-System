# --- Secrets: NEVER commit these -------------------------------------------
.env
*.pem
*.key

# --- Python ----------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Local data ------------------------------------------------------------
# Source documents are yours, not the repo's: large, copyrighted, and not
# something a clone should have to download. `material/` is DOCUMENTS_DIR.
# Learned by pushing a 118 MB textbook at GitHub's 100 MB limit.
material/*
!material/.gitkeep
data/documents/*
!data/documents/.gitkeep
data/exports/

# Derived from those documents, and reproducible from them. The OCR cache in
# particular is large and machine-specific; it is a cache, not a source.
data/ocr_cache/
data/ocr_test/

# --- Editors / OS ----------------------------------------------------------
.vscode/
.idea/
Thumbs.db
desktop.ini
